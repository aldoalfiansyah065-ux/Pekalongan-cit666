    let ranks = [];

    for (let i = 1; i <= 5; i++) {
        ranks.push(
            document.getElementById("player" + i).value
        );
    }

    let isValid = ranks.every(
        rank => rank === "Master"
    );

    let match = {
        ranks: ranks,
        valid: isValid,
        date: new Date().toLocaleString("id-ID")
    };

