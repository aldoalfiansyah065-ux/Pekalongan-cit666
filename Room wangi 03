<button onclick="checkMatch()">
CHECK MATCH
</button>

</div>

<div class="card">

<h2>🔍 MATCH RESULT</h2>

<div class="result">
    <h1 id="status">READY</h1>
    <p id="message">Menunggu pemeriksaan pertandingan.</p>
</div>

</div>

<div class="card">

<h2>📊 STATISTICS</h2>

<div class="stats">

<div class="stat">
<strong id="total">0</strong>
