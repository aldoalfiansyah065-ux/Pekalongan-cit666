</div>

</div>

<footer>
ROOM WANGI v2.0<br>
PEKALONGAN-CIT666
</footer>

<script>

const rankOptions = [
    "Master",
    "Grandmaster",
    "Epic",
    "Legend",
    "Mythic",
    "Mythical Honor",
    "Mythical Glory",
    "Mythical Immortal"
];

const players = document.getElementById("players");

for (let i = 1; i <= 5; i++) {

    let options = rankOptions.map(rank =>
        `<option value="${rank}">${rank}</option>`
    ).join("");

    players.innerHTML += `
        <div class="player">
            <label>PLAYER LAWAN ${i}</label>
            <select id="player${i}">
                ${options}
            </select>
        </div>
    `;
}

